# ---------------------------------------------------------------------------
# Copy to `.env` and fill in only what you need.
# The repo runs, tests, and evaluates with ZERO configuration: the default
# MODEL_MODE=scripted uses a deterministic in-process model (no network, no key).
# ---------------------------------------------------------------------------

# `scripted` (default) | `gemini`
# scripted -> packages/agents/src/scripted-llm.ts, deterministic, offline.
# gemini   -> real Gemini via GOOGLE_API_KEY. Non-deterministic; never used by tests.
MODEL_MODE=scripted

# Required only when MODEL_MODE=gemini. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model id used when MODEL_MODE=gemini
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=3001
# Comma-separated origins allowed to open the SSE stream.
CORS_ORIGIN=http://localhost:5173

# Milliseconds between SSE heartbeat comments. Keeps proxies from idling the
# connection out. See docs/STREAMING-CONTRACT.md.
SSE_HEARTBEAT_MS=15000
