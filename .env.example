# ---------------------------------------------------------------------------
# Copy to `.env` and fill in only what you need.
# The repo runs, tests, and evaluates with ZERO configuration: the default
# MODEL_MODE=scripted uses a deterministic in-process model (no network, no key).
# ---------------------------------------------------------------------------

# `scripted` (default) | `gemini`
# scripted -> packages/agents/src/scripted-llm.ts, deterministic, offline.
# gemini   -> real Gemini via GOOGLE_API_KEY. Non-deterministic; never used by tests.
MODEL_MODE=scripted

# Required only when MODEL_MODE=gemini. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model id used when MODEL_MODE=gemini
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=3001
# Comma-separated origins allowed to open the SSE stream.
CORS_ORIGIN=http://localhost:5173

# Milliseconds between SSE heartbeat comments. Keeps proxies from idling the
# connection out. See docs/STREAMING-CONTRACT.md.
SSE_HEARTBEAT_MS=15000

# Bytes Node may queue for one SSE subscriber before it is disconnected.
# `res.write` returning false is normal -- it means the socket buffer filled and
# Node took over queuing, which a healthy consumer drains in milliseconds. A
# consumer that never drains grows that queue without bound, so the ceiling is
# on the queue itself. The client reconnects and resumes; see L2.
SSE_MAX_BUFFERED_BYTES=1048576

# How long a session with no subscribers may sit before it is swept, releasing
# its hub and its retained events. Generous on purpose: a reload or a closed
# laptop lid is measured in seconds to minutes, and sweeping a session someone
# is coming back to costs them their history for nothing. A thread still
# running counts as activity, so an unwatched run is never thrown away. See L3.
SESSION_IDLE_TTL_MS=900000

# How often to run that sweep.
SESSION_SWEEP_INTERVAL_MS=60000

# The `retry:` value sent in the priming frame, in milliseconds. This is the
# browser's own reconnect backoff -- EventSource honours it without being asked,
# so it is the one knob that changes reconnect behaviour in the client without
# any client code. See docs/STREAMING-CONTRACT.md section 5.
SSE_RETRY_MS=1000

# ---------------------------------------------------------------------------
# Scripted-mode pacing. Only affects MODEL_MODE=scripted; with Gemini the model
# sets the pace.
#
# The defaults finish a thread in about half a second, which is great for tests
# and bad for demonstrating anything by hand -- the Stop button only exists
# while a thread is running, so at these values it appears and vanishes before
# you can click it. See L17 in docs/LIMITATIONS.md.
#
# You usually do not need to set these: `pnpm dev:demo` runs the same pair with
# watchable values (200 / 400). Set them here only to pick your own.
# ---------------------------------------------------------------------------

# Delay between streamed chunks. 25 = tests; 150-250 = watchable by a human.
SCRIPTED_CHUNK_DELAY_MS=25

# Simulated latency per tool call.
TOOL_LATENCY_MS=150

# ---------------------------------------------------------------------------
# Providers: which adapter backs each capability the app does not implement
# itself. All default to an emulated adapter that needs no external service.
# See docs/PROVIDERS.md for what each one stands in for.
# ---------------------------------------------------------------------------

# memory (default) | postgres
PROVIDER_SESSIONS=memory

# keyword (default) | vector
PROVIDER_KNOWLEDGE=keyword

# trusted-header (default) | jwt
PROVIDER_IDENTITY=trusted-header

# memory (default) | redis
# Storage, retention, replay and delivery of the per-session event stream.
PROVIDER_EVENTSTREAM=memory

# memory (default) | postgres
# The durable transcript, keyed by thread and never retained away. Distinct from
# the event stream above: that one is a window, this one is the history. See L7.
PROVIDER_MESSAGESTORE=memory

# Events retained per session: the window a reconnecting client can resume
# within. SSE_REPLAY_BUFFER is still honoured as the older name.
EVENT_RETENTION=500

# Required by PROVIDER_SESSIONS=postgres, PROVIDER_KNOWLEDGE=vector and
# PROVIDER_MESSAGESTORE=postgres.
DATABASE_URL=

# Required by PROVIDER_IDENTITY=jwt.
JWT_SECRET=

# Required by PROVIDER_EVENTSTREAM=redis.
REDIS_URL=
